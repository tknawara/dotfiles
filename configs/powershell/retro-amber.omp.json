{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "palette": {
    "rosewater": "#f5e0dc",
    "peach": "#fab387",
    "yellow": "#f9e2af",
    "red": "#f38ba8",
    "subtext0": "#a6adc8",
    "overlay0": "#6c7086",
    "green": "#a6e3a1",
    "teal": "#94e2d5",
    "sapphire": "#74c7ec"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:overlay0",
          "template": "╭─ <p:sapphire></> "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "template": "<b>TAREK</b>"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:teal",
          "template": "<p:overlay0> :: </>{{ .Path }}",
          "options": {
            "style": "full",
            "home_icon": "~"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:yellow",
          "template": "<p:overlay0> :: </>{{ .HEAD }}{{ if gt .Working.Modified 0 }}*{{ end }}{{ if .Staging.Changed }}+{{ end }}{{ if gt .Working.Untracked 0 }}?{{ end }}{{ if gt .Working.Deleted 0 }}-{{ end }}{{ if gt .Ahead 0 }}⇡{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }}⇣{{ .Behind }}{{ end }}",
          "options": {
            "fetch_status": true,
            "branch_icon": ""
          }
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:subtext0",
          "template": "<p:overlay0> :: </>{{ .FormattedMs }}",
          "options": {
            "threshold": 2000,
            "style": "austin"
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:overlay0",
          "template": "{{ .CurrentDate | date .Format }}",
          "options": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:overlay0",
          "template": "╰─"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "template": "<b>▶</b>"
        }
      ]
    }
  ]
}
